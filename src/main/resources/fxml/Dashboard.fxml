<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.stm.controller.DashboardController"
            stylesheets="@../css/style.css">

    <top>
        <VBox spacing="8" styleClass="header-bar">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>

            <Label text="Smart Task Manager" styleClass="title-label"/>

            <HBox spacing="24">
                <Label fx:id="cpuLabel" text="CPU Usage: --%" styleClass="stat-label"/>
                <Label fx:id="memLabel" text="Memory Usage: --%" styleClass="stat-label"/>
                <Label fx:id="processCountLabel" text="Total Processes: --" styleClass="stat-label"/>
            </HBox>

            <!-- Search Bar -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Search:" styleClass="stat-label"/>
                <TextField fx:id="searchField"
                           promptText="Search by process name..."
                           prefWidth="300"/>
            </HBox>

        </VBox>
    </top>

    <center>
        <TableView fx:id="processTable" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colPid" text="PID" prefWidth="70"/>
                <TableColumn fx:id="colName" text="Process" prefWidth="220"/>
                <TableColumn fx:id="colCpu" text="CPU %" prefWidth="90"/>
                <TableColumn fx:id="colMem" text="RAM (MB)" prefWidth="110"/>
                <TableColumn fx:id="colThreads" text="Threads" prefWidth="90"/>
                <TableColumn fx:id="colState" text="State" prefWidth="110"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="12" styleClass="footer-bar">
            <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
            <Label fx:id="selectionHint" text="Select one or more processes, then simulate scheduling." styleClass="hint-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="simulateButton" text="Simulate Scheduling" onAction="#onSimulateClicked" styleClass="primary-button"/>
        </HBox>
    </bottom>

</BorderPane>
